APP_NAME=image-resizer-goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Also controls timestamps in logs and API responses (created_at, etc).
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost:3000
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

# DB_CONNECTION selects which config/database.go connection block is
# active: "mysql" or "postgres". DB_SSLMODE/DB_SCHEMA are postgres-only and
# ignored under the mysql connection.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=image_resizer
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=disable
DB_SCHEMA=public

GRPC_HOST=
GRPC_PORT=

# --- Object storage (see config/filesystems.go's "s3" disk) ---
# Generated WebP outputs live here permanently - required, not optional
# (app/storage/image_storage.go's Output* functions write every completed
# result to this disk). Point this at local MinIO for development (see
# README "Local MinIO for development") or a real S3-compatible
# endpoint/bucket in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_DEFAULT_REGION=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Queue ---
# "database" makes POST /api/v1/images actually run asynchronously;
# "sync" runs jobs inline in the request (only useful for quick local checks).
QUEUE_CONNECTION=database
PROCESSING_QUEUE=image_processing
CLEANUP_QUEUE=image_cleanup

# --- Image processing (see config/image.go / app/support/imageconfig) ---

# WebP encoding. IMAGE_QUALITY_MIN/MAX are set to libvips' own full
# supported range for the WebP encoder's Q factor (0-100, confirmed via
# `vips webpsave`) - not an arbitrary app-level choice. Clients may pass a
# per-size "quality" override; it is clamped to [IMAGE_QUALITY_MIN,
# IMAGE_QUALITY_MAX].
IMAGE_DEFAULT_QUALITY=80
IMAGE_QUALITY_MIN=0
IMAGE_QUALITY_MAX=100

# How long a generated output stays available before the cleanup job deletes
# it, in seconds. Computed into each output's expires_at at creation time -
# changing this later does not affect outputs that already exist.
IMAGE_RETENTION_SECONDS=86400

# Global default for whether outputs may be enlarged beyond the source
# image's own dimensions. Applied to every request; there is no per-request
# override.
ALLOW_UPSCALE=true

# Resource limits enforced before/while processing. Sizes are in bytes.
# MAX_IMAGE_FILE_SIZE also caps uploaded file size (POST /api/v1/images).
MAX_IMAGE_FILE_SIZE=26214400
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_TOTAL_OUTPUT_PIXELS=64000000
MAX_SIZES_PER_REQUEST=10

# Concurrency. Keep MAX_CONCURRENT_IMAGE_JOBS * VIPS_CONCURRENCY roughly at
# or below the number of CPU cores available to the worker process - see
# README "Worker concurrency" for tuning guidance.
MAX_CONCURRENT_IMAGE_JOBS=4
VIPS_CONCURRENCY=2

# How often a worker updates last_heartbeat_at while processing a request,
# and how long since the last heartbeat (or since started_at, if no
# heartbeat yet) before the scheduled sweeper (app/services/stale_request_sweeper.go)
# considers a request abandoned (worker crashed/killed) and marks it failed.
HEARTBEAT_INTERVAL_SECONDS=15
STALE_PROCESSING_TIMEOUT_SECONDS=120

# Local filesystem root for generated WebP files (see the "images" disk in
# config/filesystems.go).
STORAGE_PATH=storage/app/images
